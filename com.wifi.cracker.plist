<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wifi.cracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/tongbao/wifi_cracker/autostart.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>Always</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/mac_wifi_daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mac_wifi_daemon.log</string>
</dict>
</plist>
